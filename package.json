{
    "name": "umbraco-forms-integrations-monorepo",
    "version": "0.0.0",
    "private": true,
    "description": "Root package for Umbraco.Forms.Integrations backoffice client development",
    "engines": {
        "node": ">=24.13",
        "npm": ">=11"
    },
    "workspaces": [
        "src/Umbraco.Forms.Integrations.Crm.ActiveCampaign/Client",
        "src/Umbraco.Forms.Integrations.Crm.Hubspot/Client"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "watch": "npm run watch --workspaces",
        "lint": "npm run lint --workspaces --if-present",
        "generate:api": "npm run generate:api --workspaces --if-present"
    }
}

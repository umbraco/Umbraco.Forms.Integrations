      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "UiFmKkhW9mwE0/1Qk3JFHVAdPlEFMfhdF8qRJgH2N1Ub4YDMAsu9a4X7imc6dAujfyB29k6RTI7RCGE1OwIisA=="
      }
